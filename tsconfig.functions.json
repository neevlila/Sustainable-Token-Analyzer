{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": ".netlify/functions-build",
    "resolveJsonModule": true
  },
  "include": ["netlify/functions/**/*"]
}
