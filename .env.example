# NVIDIA API Configuration
# Get your key from: https://build.nvidia.com/
# IMPORTANT: Never commit your actual API key to the repository
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API Security Token (optional, but recommended for production)
# Generate a strong random token for authentication
API_TOKEN=generate-a-strong-random-token

# Allowed origin for CORS (set to your domain in production)
ALLOWED_ORIGIN=http://localhost:5173
